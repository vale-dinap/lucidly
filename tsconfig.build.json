{
  // Compiles src/ to dist/ for the npm package: Node runs .ts files directly, but not from
  // node_modules, so an installed Lucidly needs plain JavaScript.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
